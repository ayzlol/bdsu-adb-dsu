<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app mirrors DownloadManager progress in its own notification, so the
         DownloadManager notification is hidden to keep a single, identical gauge. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Required by the Shizuku API: without this, Shizuku.requestPermission()
         never shows the grant dialog and checkSelfPermission() stays denied. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <provider android:authorities="moe.shizuku.privileged.api.shizuku" />
        <provider android:authorities="moe.shizuku.privileged.api.ShizukuProvider" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:theme="@style/Theme.Bdsu"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="com.bdsu.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Receives the "Cancel" action from the ongoing progress notification. -->
        <receiver
            android:name="com.bdsu.app.BdsuCancelReceiver"
            android:exported="false" />
        <!-- Shizuku delivers its binder to the app through this provider.
             Without it pingBinder() is always false and no permission dialog
             can ever appear, so the app stays "Not connected" forever. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.ayzlol.bdsu.shizuku"
            android:exported="true"
            android:enabled="true" />
    </application>
</manifest>
